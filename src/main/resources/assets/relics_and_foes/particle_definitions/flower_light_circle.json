{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:flower_light_circle",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "relics_and_foes:blood_light_circle"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
