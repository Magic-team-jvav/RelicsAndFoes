{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:bird_explosion2",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:campfire_smoke"
			}
		},
		"events": {
			"event": {
				"particle_effect": {
					"effect": "relics_and_foes:bird_explosion_smoke",
					"type": "emitter"
				}
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 10
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 2,
				"surface_only": true,
				"direction": ["Math.random(-1.0, 1.0)", "Math.random(-1.0, 1.0)", "Math.random(-1.0, 1.0)"]
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.size=math.sin(math.clamp(v.emitter_age,0,1)*90);"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(1.5, 2)"
			},
			"minecraft:particle_initial_speed": "Math.random(2, 3)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 0.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(v.particle_age/v.particle_lifetime)*-1+math.sin(math.min(1,v.particle_age/0.4)*90)*3", "(v.particle_age/v.particle_lifetime)*-1+math.sin(math.min(1,v.particle_age/0.4)*90)*3"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 12,
					"uv": [0, "Math.floor(variable.particle_random_2 * 12)"],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_motion_collision": {
				"enabled": "variable.particle_age > 1",
				"collision_radius": 0.25
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.19": "#FFF5F6EA",
						"0.38": "#FFFFA100",
						"0.86": "#FF2E2E2E",
						"1.0": "#002E2E2E"
					}
				}
			}
		}
	}
}