{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:big_wave",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": [1, 0, 1]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(4, 5)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,360)"
			},
			"minecraft:particle_initial_speed": "math.random(1,1.5)",
			"minecraft:particle_motion_parametric": {
				"relative_position": ["math.pow(math.sin((v.particle_age/v.particle_lifetime)*180),2)*20", 0, "math.pow(math.sin((v.particle_age/v.particle_lifetime)*180),2)*20"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [2.3, 2.3],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [56, 0],
						"size_UV": [8, 8],
						"step_UV": [-8, 0],
						"frames_per_second": 8,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#BF00CCFF",
						"0.48": "#B8C2F8FF",
						"0.77": "#B8DEFAFF",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}