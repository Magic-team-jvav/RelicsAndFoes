{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:tower_particle",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:white"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"per_update_expression": "v.rot=math.random_integer(0,3)*90+math.random(-23,23);v.rot_y=math.random(-50,-20);v.face_rot=0;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 100,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.25
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.2,
				"direction": ["math.sin(v.rot+v.face_rot)", "math.sin(v.rot_y)", "math.cos(v.rot+v.face_rot)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.5
			},
			"minecraft:particle_initial_speed": 5,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [0.04, 0.04],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFBC8",
						"0.19": "#FFFFFBC8",
						"0.82": "#FFFFFBC8",
						"1.0": "#00FFFBC8"
					}
				}
			}
		}
	}
}