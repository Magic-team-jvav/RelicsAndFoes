{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:bird_spawn",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:mist0"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 50
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 3
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-1,1)", "math.random(-1,1)", "math.random(-1,1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2.4,3.6)"
			},
			"minecraft:particle_initial_speed": "math.random(30,60)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(1-math.sin(math.min(v.particle_age / (v.particle_lifetime*0.5),1)*90))*8+0.6", 0.6],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFEDC3",
						"0.28": "#FFFFD051",
						"0.69": "#FF775600",
						"1.0": "#00432D00"
					}
				}
			}
		}
	}
}