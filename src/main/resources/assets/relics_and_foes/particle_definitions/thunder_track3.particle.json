{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:thunder_track3",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:white"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.rot=math.random(0,360);v.rot_y=math.random(-90,90);v.speed=math.random(1.5,2);"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.66
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["(v.particle_age / v.particle_lifetime)*math.cos(v.rot)*v.speed", "(v.particle_age / v.particle_lifetime)*math.sin(v.rot_y)*v.speed", "(v.particle_age / v.particle_lifetime)*math.sin(v.rot)*v.speed"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.sin((v.particle_age / v.particle_lifetime)*180)*0.5", 0.02],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "custom",
					"custom_direction": ["math.cos(v.rot)", "math.sin(v.rot_y)", "math.sin(v.rot)"]
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFA87",
						"1.0": "#FFFFFA87"
					}
				}
			}
		}
	}
}