{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:city_wind",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:light_particle"
			}
		},
		"components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": false
            },
			"minecraft:emitter_initialization": {
				"creation_expression": "v.rot=45;v.rot_y_all=math.random(-20,20);v.size=math.random(1.7,2.2);v.speed=math.random(1.1,1.4);v.pos1=math.random(-1.5,1.5);v.pos2=math.random(-1.5,1.5);v.pos3=math.random(-1.5,1.5);"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.75,0.85)"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["(v.particle_age / v.particle_lifetime)*math.cos(v.rot)*5*v.size*v.speed+v.pos1", "(v.particle_age / v.particle_lifetime)*math.sin((v.particle_age / v.particle_lifetime)*v.rot_y_all)*5*v.size*v.speed+v.pos2", "(v.particle_age / v.particle_lifetime)*math.sin(v.rot)*5*v.size*v.speed+v.pos3"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.2, "math.sin((v.particle_age / v.particle_lifetime)*180)*2*v.size"],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "custom",
					"custom_direction": ["math.cos(v.rot)", "math.sin((v.particle_age / v.particle_lifetime)*v.rot_y_all)", "math.sin(v.rot)"]
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00CBCBCB",
						"0.24": "#54CBCBCB",
						"0.71": "#54CBCBCB",
						"1.0": "#00CBCBCB"
					}
				}
			}
		}
	}
}