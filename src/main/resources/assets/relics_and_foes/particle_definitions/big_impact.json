{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:big_impact",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:square"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.normal_rot=math.random(0,360);v.r=math.random(0.9,3.5);v.h=math.random(0.5,1.25);"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.55,0.9)"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["math.sin(v.normal_rot)*(v.particle_age / v.particle_lifetime)*v.r*2", "math.sin((v.particle_age / v.particle_lifetime)*180)*v.r*v.h", "math.cos(v.normal_rot)*(v.particle_age / v.particle_lifetime)*v.r*2"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.sin((v.particle_age / v.particle_lifetime)*180)*0.75*math.ln(v.r*0.666+1)", 0.05],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "custom",
					"custom_direction": ["math.sin(v.normal_rot)", "math.sin((v.particle_age / v.particle_lifetime)*180+90)", "math.cos(v.normal_rot)"]
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.33": "#FFDAD9A3",
						"0.79": "#FF4D4442",
						"1.0": "#00242121"
					}
				}
			}
		}
	}
}