{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:priest_smoke2",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:campfire_smoke_vanilla"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-1.0, 1.0)", "math.random(0.2, 1.0)", "math.random(-1.0, 1.0)"]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.size = math.sin(120*(v.particle_age / v.particle_lifetime));"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.6,0.8)"
			},
			"minecraft:particle_initial_speed": "math.random(1, 1.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size", "variable.size"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 12,
					"uv": [0, "math.floor(variable.particle_random_2 * 12)"],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_motion_collision": {
				"enabled": "variable.particle_age > 1",
				"collision_radius": 0.25
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.2": "#FFFFFFFF",
						"0.61": "#ffffffff",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}