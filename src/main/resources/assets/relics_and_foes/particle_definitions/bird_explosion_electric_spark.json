{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:bird_explosion_electric_spark",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:light_circle"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 20
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-1,1)", "math.random(-1,1)", "math.random(-1,1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2,3)"
			},
			"minecraft:particle_initial_speed": "math.random(5,8)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -6, 0],
				"linear_drag_coefficient": 0.1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(v.particle_age/v.particle_lifetime)*4", "(1-v.particle_age/v.particle_lifetime)*0.6"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFEF0",
						"0.28": "#FFFF8D00",
						"0.69": "#FF311B00",
						"0.84": "#FF311B00",
						"1.0": "#00392100"
					}
				}
			}
		}
	}
}