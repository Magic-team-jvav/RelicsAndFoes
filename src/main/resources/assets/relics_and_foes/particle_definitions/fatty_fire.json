{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:fatty_fire",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:triangle"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 10,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 3
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-0.03,0.03)", 0.4, "math.random(-0.03,0.03)"],
				"direction": ["math.random(-1,1)", "math.random(0.5,2.5)", "math.random(-1,1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.15,0.4)"
			},
			"minecraft:particle_initial_speed": "math.random(6,12)",
			"minecraft:particle_appearance_billboard": {
				"size": ["math.sin((v.particle_age/v.particle_lifetime)*180)*0.4", "math.sin((v.particle_age/v.particle_lifetime)*180)*0.8"],
				"facing_camera_mode": "direction_x",
				"direction": {
					"mode": "custom",
					"custom_direction": ["math.random(0,1)", 0, "math.random(0,1)"]
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFE100",
						"0.28": "#FFFF7A00",
						"0.69": "#FFE12C00",
						"1.0": "#00761800"
					}
				}
			}
		}
	}
}