{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:bird_hover_attack1",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:light_particle"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 60,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.6
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 4,
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1,1.2)"
			},
			"minecraft:particle_initial_speed": "math.random(8,10)",
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["(v.particle_age/v.particle_lifetime)*2+1", "(1-v.particle_age/v.particle_lifetime)*0.4"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFEF0",
						"0.28": "#FFFF8D00",
						"0.69": "#FF311B00",
						"0.84": "#FF311B00",
						"1.0": "#00392100"
					}
				}
			}
		}
	}
}