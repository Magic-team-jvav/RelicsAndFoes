				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFEF0",
						"0.28": "#FFFF8D00",
						"0.69": "#FF311B00",
						"0.84": "#FF311B00",
						"1.0": "#00392100"
