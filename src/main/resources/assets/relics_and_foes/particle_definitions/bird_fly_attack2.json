				"linear_acceleration": [0, 0, -30]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(v.particle_age/v.particle_lifetime)*4+2", "(1-v.particle_age/v.particle_lifetime)*0.6"],
