{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:bird_fly_attack2",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:light_particle"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 60,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.7
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-1,1)", "math.random(-1,1)", "math.random(2,5)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2,3)"
			},
			"minecraft:particle_initial_speed": "math.random(18,24)",
