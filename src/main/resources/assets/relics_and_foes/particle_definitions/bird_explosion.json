{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:bird_explosion",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:campfire_smoke"
			}
		},
		"events": {
			"event": {
				"particle_effect": {
					"effect": "relics_and_foes:bird_explosion_smoke",
					"type": "emitter"
				}
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_initialization": {
				"per_update_expression": "v.size=math.sin(math.clamp(v.emitter_age,0,1)*90)*2;"
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 60,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "v.size*2",
				"surface_only": true,
				"direction": ["Math.random(-1.0, 1.0)", "Math.random(-1.0, 1.0)", "Math.random(-1.0, 1.0)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(1.8, 2.2)*(v.size*0.5+0.5)"
			},
			"minecraft:particle_initial_speed": "Math.random(1, 1.2)*(v.size*2+0.5)+1.5",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 0.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(v.particle_age/v.particle_lifetime)*2+1.5", "(v.particle_age/v.particle_lifetime)*2+1.5"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 12,
					"uv": [0, "Math.floor(variable.particle_random_2 * 12)"],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.09": "#00FFFFFF",
						"0.21": "#FFFFFFFF",
						"0.33": "#FFF5F6EA",
						"0.51": "#FFFFA100",
						"0.89": "#FF2E2E2E",
						"1.0": "#002E2E2E"
					}
				}
			}
		}
	}
}