{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:kylin_wave",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:square"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.normal_rot=math.random(0,360);v.speed=math.random(320,440)*1.35;v.rot_y=math.random(-15,15);v.r_all=math.random(9,14);"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.r=(v.particle_age / v.particle_lifetime)*v.r_all;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.6,0.85)"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["math.sin(v.normal_rot+v.particle_age*v.speed)*v.r", "math.sin(v.rot_y)*v.particle_age*3", "math.cos(v.normal_rot+v.particle_age*v.speed)*v.r"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.sin((v.particle_age / v.particle_lifetime)*180)*1*math.ln(v.r*2+1)", 0.13],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "custom",
					"custom_direction": ["math.sin(v.normal_rot+v.particle_age*v.speed+90)", "math.sin(v.rot_y)", "math.cos(v.normal_rot+v.particle_age*v.speed+90)"]
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["math.random(134,188)/255", "math.random(193,243)/255", "math.random(221,235)/255", "(1-(v.particle_age / v.particle_lifetime))*0.5+0.5"]
			}
		}
	}
}