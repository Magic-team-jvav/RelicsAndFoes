{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:impact_shoot",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:square"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-1,1)", "math.random(-2.5,0.5)", "math.random(-1,1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.55,0.9)"
			},
			"minecraft:particle_initial_speed": 10,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -10, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.sin((v.particle_age / v.particle_lifetime)*180)*1.5", 0.08],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.17": "#FFDAD9A3",
						"0.79": "#FF4D4442",
						"1.0": "#00242121"
					}
				}
			}
		}
	}
}