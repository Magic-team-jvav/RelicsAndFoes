{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:tower_track",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:white"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.rot=math.random_integer(0,3)*90+math.random(-23,23);v.rot_y=math.random(-50,-20);v.speed=math.random(2,3);v.face_rot=0;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-0.3,0.3)", "math.random(-0.3,0.3)", "math.random(-0.3,0.3)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.66
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["(v.particle_age / v.particle_lifetime)*math.cos(v.rot+v.face_rot)*v.speed", "(v.particle_age / v.particle_lifetime)*math.sin(v.rot_y)*v.speed", "(v.particle_age / v.particle_lifetime)*math.sin(v.rot+v.face_rot)*v.speed"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.sin((v.particle_age / v.particle_lifetime)*180)*0.5", 0.03],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "custom",
					"custom_direction": ["math.cos(v.rot+v.face_rot)", "math.sin(v.rot_y)", "math.sin(v.rot+v.face_rot)"]
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFA87",
						"1.0": "#FFFFFBC8"
					}
				}
			}
		}
	}
}