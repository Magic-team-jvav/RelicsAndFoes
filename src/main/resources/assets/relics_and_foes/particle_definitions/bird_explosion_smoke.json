{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "relics_and_foes:bird_explosion_smoke",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "relics_and_foes:campfire_smoke"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 20
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 3
			},
			"minecraft:emitter_shape_point": {
				"direction": ["Math.random(-1.0, 1.0)", "Math.random(-1.0, 1.0)", "Math.random(-1.0, 1.0)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(2.5, 3)"
			},
			"minecraft:particle_initial_speed": "(math.ln(50)-math.ln(Math.random(1, 50)))*1.25+math.random(3,12)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 1.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(v.particle_age/v.particle_lifetime)*7+1", "(v.particle_age/v.particle_lifetime)*7+1"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 12,
					"uv": [0, "Math.floor(variable.particle_random_2 * 12)"],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_motion_collision": {
				"enabled": "variable.particle_age > 1",
				"collision_radius": 0.25
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00959595",
						"0.14": "#00959595",
						"0.18": "#FF959595",
						"0.47": "#FF2D2D2D",
						"0.73": "#FF2D2D2D",
						"1.0": "#002E2E2E"
					}
				}
			}
		}
	}
}